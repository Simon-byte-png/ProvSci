# Optional OpenAI-compatible API. Never commit a real key.
# The deterministic local pipeline works with these values empty.
PROVSCI_API_ENABLED=false
PROVSCI_API_KEY=
PROVSCI_API_BASE_URL=https://api.openai.com/v1
PROVSCI_API_MODEL=gpt-4o-mini

# Backward-compatible xAI names are also accepted by the local app.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.5
