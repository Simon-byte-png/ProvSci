{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provsci.example/schemas/sample.schema.json",
  "title": "ProvSci auditable scientific sample",
  "type": "object",
  "required": ["id", "source", "task", "result_card", "evidence", "acquisition_path", "processing", "verification", "quality", "split"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["doc_id", "title", "year", "license", "local_path", "page_span", "source_hash"],
      "properties": {
        "doc_id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "year": {"type": "integer"},
        "license": {"type": "string", "minLength": 1},
        "local_path": {"type": "string"},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_span": {"type": "array", "minItems": 1, "items": {"type": "integer"}}
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["type", "subject", "question", "answer"],
      "properties": {
        "type": {"enum": ["numeric_qa", "table_lookup", "relation", "mcq", "open_reason"]},
        "subject": {"type": "string"},
        "question": {"type": "string", "minLength": 1},
        "answer": {"type": "object", "required": ["value", "unit", "display"]},
        "classification": {
          "type": "object",
          "required": ["result_type", "modalities", "task_family", "difficulty", "classifier"],
          "properties": {
            "result_type": {"type": "string"},
            "modalities": {"type": "array", "items": {"type": "string"}},
            "task_family": {"type": "string"},
            "difficulty": {"type": "number", "minimum": 0, "maximum": 1},
            "classifier": {"type": "string"}
          }
        }
      },
      "additionalProperties": true
    },
    "result_card": {
      "type": "object",
      "required": ["schema_version", "domain", "result_type", "entity", "metric", "value", "unit", "display", "condition", "raw_value", "normalized_value"],
      "properties": {
        "schema_version": {"const": "result_card.v1"},
        "domain": {"type": "string", "minLength": 1},
        "result_type": {"type": "string", "minLength": 1},
        "entity": {"type": ["string", "null"]},
        "metric": {"type": ["string", "null"]},
        "value": {},
        "unit": {"type": "string"},
        "display": {"type": "string"},
        "condition": {
          "type": "object",
          "required": ["text", "source", "status"],
          "properties": {
            "text": {"type": ["string", "null"]},
            "source": {"type": "string"},
            "status": {"enum": ["explicit", "not_extracted", "inferred", "conflict"]}
          },
          "additionalProperties": true
        },
        "uncertainty": {},
        "raw_value": {"type": ["string", "number", "null"]},
        "normalized_value": {
          "type": "object",
          "required": ["value", "unit"],
          "properties": {"value": {}, "unit": {"type": "string"}},
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["modality", "locator", "span_text"],
        "properties": {
          "modality": {"enum": ["text", "table", "figure", "equation", "supplement"]},
          "locator": {"type": "object"},
          "span_text": {"type": "string"}
        }
      }
    },
    "acquisition_path": {"type": "array", "minItems": 1},
    "processing": {
      "type": "object",
      "required": ["operations", "raw_value_preserved", "normalization", "raw_value", "parsed_value", "standardized_value", "transformations"],
      "properties": {
        "operations": {"type": "array", "items": {"type": "string"}},
        "raw_value_preserved": {"type": "boolean"},
        "normalization": {"type": "string"},
        "raw_value": {},
        "parsed_value": {"type": "object"},
        "standardized_value": {"type": "object"},
        "transformations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "tolerance"],
      "properties": {
        "status": {"enum": ["pass", "fail", "unknown"]},
        "evidence_checked": {"type": "boolean"},
        "tolerance": {"type": "object"}
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["needs_human_review", "failure_mode"],
      "properties": {
        "needs_human_review": {"type": "boolean"},
        "failure_mode": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "split": {"enum": ["train", "dev", "test"]}
  },
  "additionalProperties": true
}
