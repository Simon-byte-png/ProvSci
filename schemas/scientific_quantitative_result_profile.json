{
  "profile_id": "scientific_quantitative_result_v1",
  "profile_version": "1.0.0",
  "label": "通用科学定量结果",
  "scope": "公开科学文献、实验报告和结构化实验资料中的带单位定量结果及其局部实验条件。",
  "exclusions": [
    "钙钛矿/分子材料、公司生产设备和长程状态维护算法的专用任务",
    "无法确认来源许可的全文",
    "只有图像估读且没有可定位原文或图注支持的结果",
    "无法将数值绑定到明确指标或实验实体的候选"
  ],
  "result_card_schema": "schemas/result_card_v1.schema.json",
  "required_result_fields": [
    "entity",
    "metric",
    "value",
    "unit",
    "condition",
    "raw_value",
    "normalized_value"
  ],
  "supported_result_types": [
    "measurement",
    "concentration",
    "ic50",
    "yield",
    "temperature",
    "pressure",
    "duration",
    "response",
    "percentage",
    "purity",
    "efficiency",
    "intensity",
    "accuracy",
    "rate",
    "diameter",
    "width",
    "height",
    "length",
    "area",
    "mass",
    "volume",
    "density",
    "energy",
    "power",
    "frequency",
    "wavelength",
    "conductivity",
    "resistance",
    "modulus",
    "comparison_relation"
  ],
  "condition_fields": [
    "sample_or_entity",
    "treatment_or_input",
    "dose_or_concentration",
    "exposure_time_or_duration",
    "temperature",
    "pressure",
    "assay_or_method",
    "control_group",
    "replicate_or_error_definition",
    "context"
  ],
  "unit_policy": {
    "concentration": ["M", "mM", "μM", "uM", "nM", "pM", "mol/L", "mmol/L", "μmol/L", "umol/L", "mg/mL", "μg/mL", "ug/mL", "ng/mL", "U/mL", "U/ml"],
    "percentage": ["%"],
    "time": ["ms", "s", "min", "h", "day", "d"],
    "temperature": ["°C", "C", "K"],
    "length": ["nm", "μm", "um", "mm", "cm", "m"],
    "mass": ["ng", "μg", "ug", "mg", "g", "kg"],
    "volume": ["μL", "uL", "mL", "L"],
    "pressure": ["Pa", "kPa", "MPa", "bar"],
    "energy": ["J", "kJ", "eV", "keV"],
    "power": ["W", "kW"],
    "amount": ["mol", "mmol", "μmol", "umol", "nmol"]
  },
  "gold_gate": [
    "known_license",
    "evidence_locator_resolves",
    "result_card_has_entity_metric_value_unit",
    "condition_is_explicit_or_marked_not_reported",
    "acquisition_path_replays",
    "verification_status_pass",
    "no_duplicate_sample_id"
  ],
  "annotation_guidance": {
    "include": "只标注结果或结果表/图注中与实体、指标绑定的测量值；保留原始显示格式、误差和单位。",
    "exclude": "方法段中仅作为配液、设备设置或实验条件出现且未作为结果报告的数值。",
    "uncertain": "实体、指标、条件、统计口径或许可不能确认时进入 Silver/Human Review，并记录 failure_mode。"
  },
  "specialization": "领域专用 profile 可继承本 profile，收窄 metric、entity 和 condition vocabulary，但不得削弱 provenance、license 或 replay 门禁。"
}
